# Copy to .env and fill in the one key. Nothing else is needed for the demo.

# Muse Spark Open, Meta's open-weight model, on Baseten (OpenAI-compatible). Without a key the whole product still
# runs on the demo data except Sora, who tells the buyer a team member will reply.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Optional: the same Meta model family on Fireworks, used if Baseten fails or rate-limits.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=

# Optional. Leave empty and the database is embedded Postgres (PGlite) in .data/.
DATABASE_URL=

# Change these when anyone but you can reach the server.
SESSION_SECRET=dev-only-change-me
# true shows the one-click demo sign-in buttons and the Reset demo button.
DEMO_MODE=true
# false stops Sora replying; people can still answer from the desk.
FTE_ENABLED=true
# PayPal at checkout. Without keys, demo mode has a stand-in that moves no money and says so. Live: https://api-m.paypal.com
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# the back-office FTEs: invoices, accounts, operations, auction desk, CRM, website, chief of staff. false: people do those jobs
WORKFORCE_ENABLED=true
# New demo lots arrive every this many minutes (0 = off)
DEMO_FEED_MINUTES=15

# Only for a demo hosted for strangers: it puts itself back every few hours, caps the model per day, and shows the last eval run.
PUBLIC_DEMO=false
PUBLIC_DEMO_RESET_HOURS=3
PUBLIC_DEMO_TOKENS_PER_DAY=2000000

PORT=8787
PUBLIC_URL=http://localhost:5173

# Optional: push to the Android app when its owner is away. A Firebase service account's JSON, as one line or base64.
# The APK also needs that project's google-services.json in apps/mobile when it is built.
FIREBASE_SERVICE_ACCOUNT=

# Optional: a TURN relay for voice and video calls across mobile networks and strict routers. Same-network calls need none.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Optional: customers' reset links go by e-mail. Without it, demo mode shows the link on the page instead.
SMTP_URL=
MAIL_FROM=no-reply@hikari-motors.example
