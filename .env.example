# Copy to .env and fill in the one key. Nothing else is needed for the demo.

# Muse Spark Open, Meta's open-weight model, on Baseten (OpenAI-compatible). Without a key the whole product still
# runs on the demo data except Sora, who tells the buyer a team member will reply.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Optional: the same Meta model family on Fireworks, used if Baseten fails or rate-limits.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=

# Optional. Leave empty and the database is embedded Postgres (PGlite) in .data/.
DATABASE_URL=

# Change these when anyone but you can reach the server.
SESSION_SECRET=dev-only-change-me
# true shows the one-click demo sign-in buttons and the Reset demo button.
DEMO_MODE=true
# false stops Sora replying; people can still answer from the desk.
FTE_ENABLED=true

PORT=8787
PUBLIC_URL=http://localhost:5173

# Optional: a TURN relay for voice and video calls across strict networks. Same-network and most home calls need none.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
